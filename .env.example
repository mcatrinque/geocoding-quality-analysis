# Credenciais do repositório de endereços (PostGIS).
# Copie este arquivo para `.env` e ajuste os valores. O `.env` não é versionado.
# Estes são valores de desenvolvimento local: troque-os em qualquer ambiente
# acessível pela rede.

POSTGRES_USER=geocoding_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=geocoding_db

# Host/porta usados pelos scripts e pela API quando rodam fora do Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dentro do docker-compose o host é o serviço `db`; o compose já define
# DATABASE_URL para o container da API a partir das variáveis acima.
# Descomente para forçar uma URL completa em execuções locais:
# DATABASE_URL=postgresql://geocoding_user:troque-esta-senha@localhost:5432/geocoding_db
